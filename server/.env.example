PORT=5000
MONGO_URI=
MONGO_DB_NAME=findmylawyer
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173

# Advanced Search AI provider
# Recommended: keep both provider configs here and change only AI_PROVIDER.
# Valid values: deepseek | gemini
AI_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
