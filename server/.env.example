PORT=5000
MONGO_URI=
MONGO_DB_NAME=findmylawyer
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173

# Advanced Search AI provider
# Recommended: keep both provider configs here and change only AI_PROVIDER.
# Valid values: deepseek | gemini
AI_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# Development account-security OTP delivery.
# `console` prints OTPs to the server terminal and should only be used locally.
ACCOUNT_OTP_DELIVERY=console
# Optional separate HMAC secret for hashing OTPs in MongoDB. If omitted, the
# server falls back to JWT_SECRET. Use a different strong secret in production.
ACCOUNT_OTP_SECRET=
